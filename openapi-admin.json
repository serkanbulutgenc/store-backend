        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "RequiresPermission": []
          }
        ],
        "summary": "Get Me",
        "tags": [
          "staff"
        ]
      }
    },
